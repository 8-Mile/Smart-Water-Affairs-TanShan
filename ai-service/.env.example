APP_NAME=AI Service
APP_ENV=dev
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8200

# 服务间调用本 AI 服务时可选校验（主站代理可带此头）
AI_SERVICE_TOKEN=dev-ai-service-token-change-me

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=120
AI_TEMPERATURE=0.2

# 主业务（Tools 用用户 JWT 调用，需与主站同时运行）
MAIN_APP_URL=http://127.0.0.1:8000
MAIN_APP_API_PREFIX=/api/v1
MAIN_APP_TIMEOUT_SEC=30
# 与主站 AI_INTERNAL_TOKEN / AI_SERVICE_TOKEN 一致
MAIN_APP_INTERNAL_TOKEN=dev-ai-service-token-change-me
AI_TOOLS_ENABLED=true
AI_MAX_TOOL_ROUNDS=6
# 高风险：是否允许挂起 SCADA 注入（仍需用户确认）
AI_ALLOW_SCADA_INJECT=false
# 每用户对话限流
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SEC=60

# RAG
RAG_ENABLED=true
RAG_STORE_PATH=./data/rag_index.jsonl
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
