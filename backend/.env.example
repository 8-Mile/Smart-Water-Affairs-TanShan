# App
APP_NAME=生产运维管理系统
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
# 本地无 MySQL 时可用 SQLite（Phase 0 默认）：
DATABASE_URL=sqlite:///./water_ops.db
# 目标环境 MySQL：
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/water_ops?charset=utf8mb4

# CORS（前端开发地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 初始管理员（首次启动自动种子，已存在则跳过）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=系统管理员

# SCADA
# mock = 主站内置仿真（单进程开发/测试默认）
# gateway = 使用 scada-gateway 推送镜像（推荐联调：先起 8100 再起 8000）
SCADA_MODE=mock
SCADA_AUTO_START=true
SCADA_SIM_INTERVAL_SEC=1.0
SCADA_OPCUA_ENDPOINT=opc.tcp://192.168.2.222:9433
SCADA_OPCUA_SECURITY_POLICY=None
SCADA_OPCUA_AUTH_MODE=anonymous
SCADA_GATEWAY_URL=http://127.0.0.1:8100
SCADA_GATEWAY_API_PREFIX=/api/v1
SCADA_GATEWAY_TOKEN=dev-scada-gateway-token-change-me
# 接收 Gateway webhook；留空则使用 SCADA_GATEWAY_TOKEN
SCADA_INGEST_TOKEN=
# latest/history：mirror=主站镜像表（默认）；gateway=透传 Gateway
SCADA_DATA_SOURCE=mirror

# 本地 AI（阶段 4，依赖 Ollama + ai-service :8200）
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8200
AI_SERVICE_API_PREFIX=/api/v1
AI_SERVICE_TOKEN=dev-ai-service-token-change-me
# 档案 internal 接口；留空则用 AI_SERVICE_TOKEN
AI_INTERNAL_TOKEN=
AI_TIMEOUT_SEC=120
# 上传档案后异步通知 ai-service 建索引
AI_RAG_INDEX_ON_UPLOAD=true

# 上传与安全
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
ENABLE_DOCS=true
ENABLE_AUDIT_LOG=true
LOGIN_RATE_LIMIT_WINDOW_SEC=300
LOGIN_RATE_LIMIT_MAX=20
# 生产：APP_ENV=prod 会关闭 /docs（除非 ENABLE_DOCS 逻辑另配）
