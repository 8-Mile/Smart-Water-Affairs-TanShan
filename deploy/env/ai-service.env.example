# ===== ai-service 生产环境配置 =====
# AI_SERVICE_TOKEN 必须与 backend/.env 的 AI_SERVICE_TOKEN 一致，
# 首次部署时由 deploy.sh 统一注入同一个随机值。
# 注意：本服务依赖同机的 Ollama（默认 http://127.0.0.1:11434），需先安装并拉取下方配置的模型。

APP_NAME=AI Service
APP_ENV=prod
HOST=127.0.0.1
PORT=8200
AI_SERVICE_TOKEN=__AI_TOKEN__

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=120
AI_TEMPERATURE=0.2

# 主业务（Tools 用用户 JWT 回调主站，需与主站同时运行）
MAIN_APP_URL=http://127.0.0.1:8000
MAIN_APP_API_PREFIX=/api/v1
MAIN_APP_TIMEOUT_SEC=30
