# ===== backend 生产环境配置 =====
# 首次部署时 deploy.sh 会把 __XXX__ 占位符替换为随机生成的密钥；此后重复部署不会覆盖本文件。

APP_NAME=生产运维管理系统
APP_ENV=prod
DEBUG=false
API_V1_PREFIX=/api/v1

# JWT（__JWT_SECRET__ 由 deploy.sh 注入随机值）
JWT_SECRET=__JWT_SECRET__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据库：默认 SQLite（单文件，随 WorkingDirectory 存放在 /opt/water-ops/backend/）
# 如需 MySQL：DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/water_ops?charset=utf8mb4
DATABASE_URL=sqlite:///./water_ops.db

# 生产由 Nginx 同源反代，无需放开 CORS；如前后端分离部署再填前端来源（逗号分隔）
CORS_ORIGINS=

# 初始管理员（仅数据库为空、首次启动时种子一次）——请务必改成强密码
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BOOTSTRAP_ADMIN_NAME=系统管理员

# SCADA：gateway 模式（与 scada-gateway 服务协同部署）
# 接真实 OPC UA 的地址在 scada-gateway 的 .env 中配置，这里不重复
SCADA_MODE=gateway
SCADA_AUTO_START=false
SCADA_GATEWAY_URL=http://127.0.0.1:8100
SCADA_GATEWAY_API_PREFIX=/api/v1
SCADA_GATEWAY_TOKEN=__SCADA_TOKEN__
SCADA_INGEST_TOKEN=__SCADA_TOKEN__
SCADA_DATA_SOURCE=mirror

# 本地 AI（依赖本机 Ollama :11434）
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8200
AI_SERVICE_API_PREFIX=/api/v1
AI_SERVICE_TOKEN=__AI_TOKEN__
AI_INTERNAL_TOKEN=__AI_TOKEN__
AI_TIMEOUT_SEC=120
AI_RAG_INDEX_ON_UPLOAD=true

# 上传与安全
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
ENABLE_DOCS=false
ENABLE_AUDIT_LOG=true
LOGIN_RATE_LIMIT_WINDOW_SEC=300
LOGIN_RATE_LIMIT_MAX=20
