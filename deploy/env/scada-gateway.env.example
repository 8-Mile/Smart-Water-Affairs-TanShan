# ===== scada-gateway 生产环境配置 =====
# GATEWAY_TOKEN / MAIN_APP_WEBHOOK_TOKEN 必须与 backend/.env 的 SCADA_GATEWAY_TOKEN 一致，
# 首次部署时由 deploy.sh 统一注入同一个随机值。

APP_NAME=SCADA Gateway
APP_ENV=prod
GATEWAY_TOKEN=__SCADA_TOKEN__

DATABASE_URL=sqlite:///./scada_hub.db

# 数据源：mock=内置仿真（验证链路用）；投运接真实设备时改为 opcua 并填下方 OPCUA_* 
SOURCE_MODE=mock
AUTO_START=true
SIM_INTERVAL_SEC=1.0

# 镜像数据保留
RETENTION_DAYS=90
RETENTION_INTERVAL_SEC=3600

# 推送样本到主站（webhook 令牌同样与 GATEWAY_TOKEN 一致）
MAIN_APP_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/internal/scada/samples
MAIN_APP_WEBHOOK_TOKEN=__SCADA_TOKEN__

# SOURCE_MODE=opcua 时填写：
OPCUA_ENDPOINT=opc.tcp://192.168.2.222:9433
OPCUA_SECURITY_POLICY=None
OPCUA_AUTH_MODE=anonymous
OPCUA_USERNAME=
