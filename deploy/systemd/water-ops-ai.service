[Unit]
Description=Water Ops AI Service (:8200, internal)
# 依赖本机 Ollama；若 Ollama 未以 systemd 服务安装，可删除 Wants/After 中的 ollama.service
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=waterops
Group=waterops
WorkingDirectory=/opt/water-ops/ai-service
EnvironmentFile=/opt/water-ops/ai-service/.env
# 仅监听回环：只接受本机 backend 调用，不对局域网暴露
ExecStart=/opt/water-ops/ai-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8200 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
