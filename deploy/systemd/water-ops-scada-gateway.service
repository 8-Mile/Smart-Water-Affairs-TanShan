[Unit]
Description=Water Ops SCADA Gateway (:8100, internal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waterops
Group=waterops
WorkingDirectory=/opt/water-ops/scada-gateway
EnvironmentFile=/opt/water-ops/scada-gateway/.env
# 仅监听回环：只接受本机 backend 调用，不对局域网暴露
ExecStart=/opt/water-ops/scada-gateway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
