  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DashboardLayout": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "widgets": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "KpiCard",
                    "LineChart",
                    "BarChart",
                    "DualAxisChart",
                    "DataTable",
                    "TextSummary",
                    "AlertList"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "dataset": {
                  "type": "string",
                  "enum": [
                    "rain",
                    "energy",
                    "alarms"
                  ]
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "w": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 10
                },
                "locked": {
                  "default": false,
                  "type": "boolean"
                },
                "sort": {
                  "default": "default",
                  "type": "string",
                  "enum": [
                    "default",
                    "asc",
                    "desc"
                  ]
                },
                "average": {
                  "default": false,
                  "type": "boolean"
                },
                "columns": {
                  "default": [
                    "label",
                    "area",
                    "value"
                  ],
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "label",
                      "area",
                      "value",
                      "energy"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "type",
