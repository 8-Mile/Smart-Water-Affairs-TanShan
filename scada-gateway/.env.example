APP_NAME=SCADA Gateway
APP_ENV=dev
API_V1_PREFIX=/api/v1

# 服务间鉴权（主业务系统调用时携带 X-Gateway-Token）
GATEWAY_TOKEN=dev-scada-gateway-token-change-me

# 数据库（开发 SQLite；生产可改 MySQL）
DATABASE_URL=sqlite:///./scada_hub.db

# 数据源：mock | opcua（阶段 1 仅 mock）
SOURCE_MODE=mock
AUTO_START=true
SIM_INTERVAL_SEC=1.0

# 历史保留天数（0=不清理）；后台按间隔删除更早的 gw_tag_data
RETENTION_DAYS=90
RETENTION_INTERVAL_SEC=3600

# 主站 Webhook（阶段 2：推送到主业务 Ingest）
# 例：http://127.0.0.1:8000/api/v1/internal/scada/samples
MAIN_APP_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/internal/scada/samples
# 与主站 SCADA_GATEWAY_TOKEN / SCADA_INGEST_TOKEN 一致
MAIN_APP_WEBHOOK_TOKEN=dev-scada-gateway-token-change-me

# OPC-UA（SOURCE_MODE=opcua 时生效）
OPCUA_ENDPOINT=opc.tcp://192.168.2.222:9433
OPCUA_SECURITY_POLICY=None
# anonymous | user
OPCUA_AUTH_MODE=anonymous
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_CERT_PATH=
OPCUA_KEY_PATH=
OPCUA_TIMEOUT_SEC=10
OPCUA_SUBSCRIPTION_PERIOD_MS=500
OPCUA_POLL_INTERVAL_SEC=2
OPCUA_RECONNECT_SEC=3
# inject 是否写回 OPC（默认否，仅改本地镜像）
OPCUA_ALLOW_WRITE=false

HOST=0.0.0.0
PORT=8100
